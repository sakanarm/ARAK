# ============================================================
# Copy to .env and fill in.  .env is gitignored — never commit it.
# ============================================================

# --- OpenMetadata (catalog) ---
# Your OpenMetadata instance, e.g. http://openmetadata.internal:8585
OM_BASE_URL=
# Prefer a BOT token over a human account.
# OpenMetadata UI -> Settings -> Bots -> create bot -> copy JWT token.
OM_JWT_TOKEN=
# Expected server version; the connector logs a warning on mismatch.
OM_EXPECTED_VERSION=2.0.1

# --- App database ---
APP_DB_URL=jdbc:postgresql://localhost:5432/dac
APP_DB_USER=dac
APP_DB_PASSWORD=change-me

# --- Identity: Microsoft Entra ID (OIDC) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Phase 1 may run with local users only; leave the above blank to do so.
IDENTITY_ALLOW_LOCAL_USERS=true

# --- Managed data sources (dev sandbox from deploy/docker-compose.yml) ---
SRC_PG_URL=jdbc:postgresql://localhost:55432/sales
SRC_PG_USER=postgres
SRC_PG_PASSWORD=dev-only-change-me
SRC_MSSQL_URL=jdbc:sqlserver://localhost:51433;databaseName=SalesDB;encrypt=false
SRC_MSSQL_USER=sa
SRC_MSSQL_PASSWORD=Dev0nly!Change

# --- Secrets backend: fernet | vault | azure_key_vault ---
# There is no plaintext option, deliberately: source credentials are the
# keys to every table this platform governs.
SECRETS_PROVIDER=fernet
FERNET_KEY=
