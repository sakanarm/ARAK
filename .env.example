# ============================================================
# Copy to .env and fill in.  .env is gitignored — never commit it.
# ============================================================

# --- OpenMetadata (catalog) ---
# Your OpenMetadata instance, e.g. http://openmetadata.internal:8585
OM_BASE_URL=
# Prefer a BOT token over a human account.
# OpenMetadata UI -> Settings -> Bots -> create bot -> copy JWT token.
OM_JWT_TOKEN=
# Expected server version; the connector logs a warning on mismatch.
OM_EXPECTED_VERSION=2.0.1
# Shared secret for the change-event webhook. Use the same value you put in the
# OpenMetadata event subscription (Settings -> Alerts -> destination -> secret
# key). Without it the receiver refuses every delivery -- it is the only thing
# authenticating that endpoint.
#   openssl rand -base64 32
OM_WEBHOOK_SECRET=
# Pull side of the sync, and the backstop for a missed webhook.
OM_POLL_ENABLED=true
OM_POLL_INTERVAL_SECONDS=60
OM_MAX_EVENTS_PER_POLL=2000
# Nightly full crawl, in the operator's own time zone.
OM_RECONCILE_ENABLED=true
OM_RECONCILE_AT=02:30
OM_RECONCILE_ZONE=Asia/Bangkok

# --- App database ---
APP_DB_URL=jdbc:postgresql://localhost:5432/dac
APP_DB_USER=dac
APP_DB_PASSWORD=change-me

# --- Identity: Microsoft Entra ID (OIDC) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Phase 1 may run with local users only; leave the above blank to do so.
IDENTITY_ALLOW_LOCAL_USERS=true

# --- Console session token (required; the app refuses to start without it) ---
# openssl rand -base64 48
IDENTITY_JWT_SECRET=
IDENTITY_JWT_ISSUER=data-access-control
IDENTITY_JWT_TTL_SECONDS=3600
IDENTITY_MAX_FAILED_LOGIN_ATTEMPTS=5
IDENTITY_LOCKOUT_SECONDS=900

# First-run password for the seeded local `admin` account. Applied only while
# no local credential exists at all; the console then forces a change at first
# sign-in. Clear this variable once you have signed in.
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=

# --- Managed data sources (dev sandbox from deploy/docker-compose.yml) ---
SRC_PG_URL=jdbc:postgresql://localhost:55432/sales
SRC_PG_USER=postgres
SRC_PG_PASSWORD=dev-only-change-me
SRC_MSSQL_URL=jdbc:sqlserver://localhost:51433;databaseName=SalesDB;encrypt=false
SRC_MSSQL_USER=sa
SRC_MSSQL_PASSWORD=Dev0nly!Change

# --- Secrets backend: fernet | vault | azure_key_vault ---
# There is no plaintext option, deliberately: source credentials are the
# keys to every table this platform governs.
SECRETS_PROVIDER=fernet
FERNET_KEY=
